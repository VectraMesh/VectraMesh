<Window x:Class="VectraMesh.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VectraMesh.Studio" Height="800" Width="1200" WindowStartupLocation="CenterScreen" >

    <Window.Resources>
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="LightGray" />
        <SolidColorBrush x:Key="ControlForegroundBrush" Color="#243746" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#27A0DA" />
        <SolidColorBrush x:Key="ControlHighlightBrush" Color="#C0DDEB" />
        <SolidColorBrush x:Key="ControlPressedBrush" Color="#B8D8EF" />

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource ControlForegroundBrush}" />
            <Setter Property="Padding" Value="10,2,10,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource ControlHighlightBrush}" />
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter Property="Background" Value="{StaticResource ControlHighlightBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource ControlHighlightBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ControlForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,2,10,3" />
            <Setter Property="Margin" Value="5,2,5,1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ControlHighlightBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource ControlPressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition/>
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Menu x:Name="TopMenu" />
        <Grid x:Name="BgImageGrid" Grid.Row="1" >
        </Grid>
        <Canvas x:Name="DrawCanvas"  Grid.Row="1" Background="#8FFFFFFF"/>
        <Border x:Name="SaveGrid" Grid.Row="1" BorderBrush="DarkGray" BorderThickness="1" Margin="5" Background="AliceBlue" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Opacity="0.9">
            <Grid Grid.Row="1"  >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="SaverTop" Orientation="Horizontal" >
                    <StackPanel Margin="10" >
                        <RadioButton x:Name="RbAllSegments" Content="All segments/Project as Json"  Margin="10,0" Padding="10,0"  IsChecked="True" Checked="SaveMethodChanged"  Unchecked="SaveMethodChanged" />
                        <RadioButton x:Name="RbPicturePngFormat" Content="Picture as PNG"  Margin="10,0" Padding="10,0" Checked="SaveMethodChanged"  Unchecked="SaveMethodChanged" />
                        <RadioButton x:Name="RbMeshJsonFormat" Content="Meshes as Json"  Margin="10,0" Padding="10,0" Checked="SaveMethodChanged"  Unchecked="SaveMethodChanged" />
                        <RadioButton x:Name="RbMeshWpfFormat" Content="Meshes as WPF format"  Margin="10,0" Padding="10,0" Checked="SaveMethodChanged"  Unchecked="SaveMethodChanged" />
                        <RadioButton x:Name="RbPolygonsWpf"  Content="Polygons for WPF"  Margin="10,0" Padding="10,0" Checked="SaveMethodChanged"  Unchecked="SaveMethodChanged" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="SaverMiddle" Orientation="Horizontal"  Visibility="Hidden" Grid.Row="1" >
                    <StackPanel Margin="10">
                        <RadioButton x:Name="RbFile" Content="File"  Margin="10,0" Padding="10,0"  IsChecked="True"  />
                        <RadioButton x:Name="RbClipboard" Content="Clipboard"  Margin="10,0" Padding="10,0"   />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
                    <Button x:Name="ButtonSave" Content="Save" Margin="10,0" Padding="10,0" Click="ButtonSaveSave_Click" />
                    <Button Content="Cancel" Margin="10,0" Padding="10,0" Click="ButtonSaveCancel_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="MessageGrid" Grid.Row="2" Background="#FFEAEFEF">
            <DockPanel x:Name="DrawPolylinePanel"  HorizontalAlignment="Stretch" Visibility="Hidden">
                <Button Content="Finish polyline" Click="FinishPolyline_Click" />
                <Button Content="Bezier (Pro)" Click="Advertising_Click" />
                <TextBlock x:Name="DrawPolylineCoord" />
                <TextBlock x:Name="DrawPolylinePointInfo" />
                <Button Content="Help" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="HelpDrawPolyline" />
            </DockPanel>
            <DockPanel x:Name="EditPanel"  HorizontalAlignment="Stretch" Visibility="Hidden">
                <Button x:Name="ButtonEraseSegment"  Content="Erase segment" Click="EraseSegmentClick" />
                <Button x:Name="ButtonMoveCorner" Content="Move corner" Click="MoveCornerClick" />
                <Button Content="Clear all" Click="ClearAllClick" />
                <TextBlock x:Name="MoveCornerCoord" />
                <TextBlock x:Name="MoveCornerPointInfo" />
                <Button Content="Help" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="HelpEdit" />
            </DockPanel>
            <StackPanel x:Name="BackgroundImagePanel" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Hidden">
                <Button Content="Open image file" Click="OpenBackgroundImage" />
                <Button Content="Erase background image" Click="EraseBackgroundImage" />
                <TextBlock Text="Drag and drop image file on canvas or open image file. Adjust window size to get a desirable image form factor." />
            </StackPanel>
            <DockPanel x:Name="TriangulatePanel"  HorizontalAlignment="Stretch" Visibility="Hidden">
                <Button x:Name="ButtonTriangulateHolesVms" Content="Triangulate with holes" Click="TriangulateHolesVms" Visibility="Collapsed"/>
                <Button x:Name="ButtonAnalyzeVms" Content="Analyze triangles"  Click="AnalyzeVms" Visibility="Hidden"/>
                <TextBlock x:Name="RecognitionInfo" Text="" />
                <TextBlock x:Name="TriangulationInfo" Text="" />
                <TextBlock x:Name="TriangulationQuality" Text="" />
                <TextBlock x:Name="TriangulatePointInfo" Text="" />
                <TextBlock x:Name="TriangulateTriangleInfo" Text="" />
                <TextBlock x:Name="TriangulateError" Foreground="Red" Text="" />
                <Button Content="Help" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="HelpAnalyze" />
            </DockPanel>
            <DockPanel x:Name="EarCutPanel" HorizontalAlignment="Stretch" Visibility="Hidden">
                <Button x:Name="ButtonAnalyzeEarCutTriangles" Content="Analyze triangles" Click="AnalyzeEarCutTriangles" Visibility="Hidden" />
                <TextBlock x:Name="EarCutDiagnosticInfo" Text="" />
                <TextBlock x:Name="EarCutQuality" Text="" />
                <TextBlock x:Name="EarCutPointInfo" Text="" />
                <TextBlock x:Name="EarCutTriangleInfo" />
                <TextBlock x:Name="EarCutError" Foreground="Red" />
                <Button Content="Help" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="HelpAnalyze" />
            </DockPanel>
            <StackPanel x:Name="SavePanel" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Hidden">
                <TextBlock x:Name="SaveInfo" HorizontalAlignment="Center" Text=""/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
