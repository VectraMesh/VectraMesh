<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>VectraMesh.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="VectraMesh.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Earcut.NET" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="VectraMesh" Version="1.0.0" />
  </ItemGroup>


</Project>
